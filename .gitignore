# Root-level artifacts
.DS_Store

# Frontend artifacts
/frontend/node_modules
/frontend/build
/frontend/coverage
/frontend/.pnp
/frontend/.pnp.js
/frontend/.env.local
/frontend/.env.development.local
/frontend/.env.test.local
/frontend/.env.production.local
/frontend/npm-debug.log*
/frontend/yarn-debug.log*
/frontend/yarn-error.log*

# Legacy root artifacts (safe to ignore if present)
/node_modules
/build
/coverage

# Backend / Python artifacts (one venv at repo root: .venv)
.venv/
venv/
/backend/venv/
/backend/__pycache__/
/backend/**/*.pyc

# Local environment files (referenced in backend/config.py - never commit secrets)
.env
.env.*
!.env.example
*.env
*.env.local
/backend/.env
/backend/.env.*
!/backend/.env.example
/frontend/.env
/frontend/.env.*
!/frontend/.env.example

# Local database files (referenced in backend/config.py database_url)
/backend/specsvision.db
/backend/db.sqlite3
*.sqlite3
*.sqlite
*.db

# Uploads & temporary artifacts (referenced in backend/config.py upload settings)
/backend/uploads/temp/
*.tmp
*.bak
*.part

# Logs
*.log

# Local editor settings
.vscode/
.idea/
