# Frontend environment configuration.
#
# Local development:
#   Copy this file to `.env.development.local` (Create React App loads it
#   automatically) and point it at your local API.
#
# Production (Netlify):
#   Set REACT_APP_API_URL in Site settings > Environment variables to the
#   deployed backend origin. Do NOT commit a .env file -- a committed
#   localhost URL is baked into the production bundle at build time.

REACT_APP_API_URL=http://127.0.0.1:8000

# Stripe publishable key (safe for the client; the secret key stays server-side).
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
